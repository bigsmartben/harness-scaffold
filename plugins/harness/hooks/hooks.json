{
  "description": "Optional Harness 2.0 defense-in-depth checks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sdd-harness hook",
            "timeout": 10,
            "statusMessage": "Checking Harness projection"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sdd-harness hook",
            "timeout": 10,
            "statusMessage": "Checking governed action"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sdd-harness hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sdd-harness hook",
            "timeout": 10,
            "statusMessage": "Checking governance drift"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sdd-harness hook",
            "timeout": 10,
            "statusMessage": "Checking Harness Evidence"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sdd-harness hook",
            "timeout": 10,
            "statusMessage": "Closing Harness session"
          }
        ]
      }
    ]
  }
}
