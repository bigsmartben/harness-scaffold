{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-harness.local/schemas/impact.schema.json",
  "title": "Impact rules",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths", "validation_level"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/stableId" },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "validation_level": { "$ref": "common.schema.json#/$defs/validationLevel" },
          "tasks": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/stableId" },
            "uniqueItems": true
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}

