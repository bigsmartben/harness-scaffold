{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-harness.local/schemas/common.schema.json",
  "title": "AI Coding Harness shared contract",
  "x-harness-schema-version": "0.3.0",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "validationLevel": {
      "enum": ["inspect", "affected", "contract", "integration", "full", "publish"]
    },
    "actionSemantics": {
      "enum": [
        "ordinary",
        "lint",
        "validation",
        "test",
        "build",
        "codegen",
        "ci",
        "package",
        "push",
        "pull-request",
        "merge",
        "publish",
        "release",
        "deploy"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "blockerCode": {
      "enum": [
        "WRITE_SCOPE_EXPANDED",
        "TOOL_NOT_REGISTERED",
        "TOOL_ENTRY_STALE",
        "IMPACT_UNRESOLVED",
        "TASK_BYPASS_ATTEMPT",
        "ACTION_CLASSIFICATION_UNRESOLVED",
        "HANDOFF_REQUIRED",
        "CONTROLLED_BRANCH_GATE_REQUIRED",
        "PUBLISH_CONFIRMATION_REQUIRED",
        "PROTECTED_TRIGGER_UNCONTROLLED",
        "CONFIG_INVALID",
        "BACKEND_UNAVAILABLE",
        "EVIDENCE_INCOMPLETE",
        "PLAN_STALE",
        "GRANT_STALE",
        "EVIDENCE_BINDING_MISMATCH",
        "GOVERNANCE_SOURCE_MISSING",
        "GOVERNANCE_CONFLICT",
        "GOVERNANCE_SCOPE_UNRESOLVED",
        "GOVERNANCE_INHERITANCE_INVALID",
        "GOVERNANCE_PROJECTION_STALE",
        "GOVERNANCE_COVERAGE_INCOMPLETE",
        "TOOL_ACTION_UNCLASSIFIED",
        "TOOL_BINDING_AMBIGUOUS",
        "GOVERNANCE_PRECONDITION_FAILED",
        "INVOCATION_BYPASS_ATTEMPT",
        "GOVERNANCE_NOT_ENFORCEABLE",
        "GOVERNANCE_EVIDENCE_INCOMPLETE",
        "GOVERNANCE_DRIFT_DETECTED",
        "AGENT_BINDING_UNAVAILABLE",
        "AGENT_ROLE_CONTRACT_INVALID",
        "AGENT_CONFIGURATION_UNTRUSTED"
      ]
    },
    "audience": {
      "enum": ["maintainer", "consumer"]
    },
    "subdomain": {
      "enum": [
        "agent-runtime",
        "engineering-runtime",
        "poc",
        "source-code",
        "test-code",
        "other-tools"
      ]
    },
    "agentRole": {
      "enum": [
        "repo_mapper",
        "governance_projector",
        "projection_reconciler",
        "governance_validator",
        "governed_worker",
        "evidence_verifier"
      ]
    },
    "responsibility": {
      "enum": ["generate", "enforce"]
    },
    "enforcementLevel": {
      "enum": ["documented", "verified", "enforced"]
    },
    "confirmationPolicy": {
      "enum": ["none", "once_per_change_set", "once_per_delivery"]
    },
    "bindingState": {
      "enum": ["detected", "declared", "bound"]
    }
  }
}
