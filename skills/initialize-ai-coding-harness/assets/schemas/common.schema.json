{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-harness.local/schemas/common.schema.json",
  "title": "AI Coding Harness shared contract",
  "x-harness-schema-version": "0.3.0",
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    },
    "validationLevel": {
      "enum": ["inspect", "affected", "contract", "integration", "full", "publish"]
    },
    "actionSemantics": {
      "enum": [
        "ordinary",
        "lint",
        "validation",
        "test",
        "build",
        "ci",
        "package",
        "push",
        "merge",
        "publish",
        "release",
        "deploy"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "blockerCode": {
      "enum": [
        "WRITE_SCOPE_EXPANDED",
        "TOOL_NOT_REGISTERED",
        "TOOL_ENTRY_STALE",
        "IMPACT_UNRESOLVED",
        "TASK_BYPASS_ATTEMPT",
        "ACTION_CLASSIFICATION_UNRESOLVED",
        "HANDOFF_REQUIRED",
        "CONTROLLED_BRANCH_GATE_REQUIRED",
        "PUBLISH_CONFIRMATION_REQUIRED",
        "PROTECTED_TRIGGER_UNCONTROLLED",
        "CONFIG_INVALID",
        "BACKEND_UNAVAILABLE",
        "EVIDENCE_INCOMPLETE",
        "PLAN_STALE",
        "GRANT_STALE",
        "EVIDENCE_BINDING_MISMATCH"
      ]
    }
  }
}
