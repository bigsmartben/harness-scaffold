{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-harness.local/schemas/boundaries.schema.json",
  "title": "Controlled branch gate",
  "x-harness-schema-version": "0.3.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["branch_gate"],
  "properties": {
    "branch_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlled",
        "private",
        "unmatched",
        "actions",
        "confirmation",
        "platform_gate",
        "blocker_codes"
      ],
      "properties": {
        "controlled": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^refs/heads/"
          },
          "uniqueItems": true
        },
        "private": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^refs/heads/"
          },
          "uniqueItems": true
        },
        "unmatched": { "const": "controlled" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["push", "pull-request", "merge"] },
          "uniqueItems": true
        },
        "confirmation": { "const": "strong" },
        "platform_gate": { "const": "required" },
        "blocker_codes": {
          "type": "array",
          "const": [
            "CONTROLLED_BRANCH_GATE_REQUIRED",
            "HANDOFF_REQUIRED"
          ]
        }
      }
    }
  }
}
