{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-harness.local/schemas/runtime.schema.json",
  "title": "AI Coding Harness runtime artifacts",
  "x-harness-schema-version": "1.0.0",
  "oneOf": [
    { "$ref": "#/$defs/plan" },
    { "$ref": "#/$defs/planApproval" },
    { "$ref": "#/$defs/workGrant" },
    { "$ref": "#/$defs/changeManifest" },
    { "$ref": "#/$defs/selection" },
    { "$ref": "#/$defs/taskRequest" },
    { "$ref": "#/$defs/confirmation" },
    { "$ref": "#/$defs/evidence" },
    { "$ref": "#/$defs/platformEvidence" }
  ],
  "$defs": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "digest": {
      "$ref": "common.schema.json#/$defs/digest"
    },
    "nullableDigest": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "sourceState": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "$ref": "common.schema.json#/$defs/digest" },
          { "const": "absent" }
        ]
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "path",
        "template",
        "merge",
        "before_digest",
        "after_digest"
      ],
      "properties": {
        "action": { "enum": ["create", "update", "preserve"] },
        "path": { "type": "string", "minLength": 1 },
        "template": { "type": ["string", "null"] },
        "merge": {
          "enum": ["replace", "replace-marked-block", "preserve"]
        },
        "before_digest": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/digest" },
            { "const": "absent" }
          ]
        },
        "after_digest": {
          "oneOf": [
            { "$ref": "common.schema.json#/$defs/digest" },
            { "type": "null" }
          ]
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "plan_type",
        "repository_root",
        "read_only",
        "source_facts_digest",
        "source_facts",
        "source_state",
        "write_scope",
        "actions",
        "preserve",
        "render_context",
        "blocker_codes",
        "drift",
        "plan_digest"
      ],
      "properties": {
        "artifact_type": { "const": "plan" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "plan_type": { "enum": ["adopt", "bootstrap", "audit", "update"] },
        "repository_root": { "type": "string", "minLength": 1 },
        "read_only": { "type": "boolean" },
        "source_facts_digest": { "$ref": "#/$defs/digest" },
        "source_facts": { "type": "object" },
        "source_state": { "$ref": "#/$defs/sourceState" },
        "write_scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "preserve": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "render_context": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "blocker_codes": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/blockerCode" },
          "uniqueItems": true
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "field", "decision", "reason"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "field": { "type": "string", "minLength": 1 },
              "decision": { "enum": ["create", "update", "preserve", "block"] },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "plan_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "planApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "plan_digest",
        "confirmation_status",
        "confirmed_at"
      ],
      "properties": {
        "artifact_type": { "const": "plan-approval" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "plan_digest": { "$ref": "#/$defs/digest" },
        "confirmation_status": { "const": "confirmed" },
        "confirmed_at": { "type": "string", "minLength": 1 }
      }
    },
    "workGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "grant_id",
        "goal",
        "write_scope",
        "merge_target",
        "validation_policy",
        "delivery_target",
        "risk_level",
        "status",
        "grant_digest"
      ],
      "properties": {
        "artifact_type": { "const": "work-grant" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "grant_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "goal": { "type": "string", "minLength": 1 },
        "write_scope": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "merge_target": { "type": "string", "minLength": 1 },
        "validation_policy": { "const": "minimum-sufficient" },
        "delivery_target": { "$ref": "#/$defs/nullableString" },
        "risk_level": { "enum": ["low", "medium", "high"] },
        "status": { "enum": ["active", "expired"] },
        "grant_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "changeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "manifest_id",
        "grant_digest",
        "base_commit",
        "changed_paths",
        "affected_modules",
        "public_contract_changed",
        "dependency_changed",
        "build_config_changed",
        "recommended_tasks",
        "manifest_digest"
      ],
      "properties": {
        "artifact_type": { "const": "change-manifest" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "manifest_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "grant_digest": { "$ref": "#/$defs/digest" },
        "base_commit": { "type": "string", "minLength": 1 },
        "changed_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "affected_modules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "public_contract_changed": { "type": "boolean" },
        "dependency_changed": { "type": "boolean" },
        "build_config_changed": { "type": "boolean" },
        "recommended_tasks": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/stableId" },
          "uniqueItems": true
        },
        "manifest_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "selectedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "automation_level",
        "decision",
        "reason"
      ],
      "properties": {
        "task_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "automation_level": {
          "enum": ["routine", "expensive", "critical", "confirmation-required"]
        },
        "decision": { "enum": ["automatic", "confirmation-required"] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "selection_id",
        "manifest_digest",
        "diff_digest",
        "status",
        "validation_level",
        "selected_tasks",
        "skipped_tasks",
        "reasons",
        "blocker_codes",
        "selection_digest"
      ],
      "properties": {
        "artifact_type": { "const": "selection" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "selection_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "diff_digest": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["selected", "confirmation-required", "blocked"] },
        "validation_level": {
          "$ref": "common.schema.json#/$defs/validationLevel"
        },
        "selected_tasks": {
          "type": "array",
          "items": { "$ref": "#/$defs/selectedTask" }
        },
        "skipped_tasks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "reason"],
            "properties": {
              "task_id": { "$ref": "common.schema.json#/$defs/stableId" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "blocker_codes": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/blockerCode" },
          "uniqueItems": true
        },
        "selection_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "taskRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "request_id",
        "task_id",
        "action_semantics",
        "validation_level",
        "target",
        "commit_sha",
        "version",
        "artifact_digest",
        "environment",
        "automation_level",
        "policy_version",
        "grant_digest",
        "manifest_digest",
        "selection_digest",
        "request_digest"
      ],
      "properties": {
        "artifact_type": { "const": "task-request" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "request_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "task_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "action_semantics": {
          "$ref": "common.schema.json#/$defs/actionSemantics"
        },
        "validation_level": {
          "$ref": "common.schema.json#/$defs/validationLevel"
        },
        "target": { "$ref": "#/$defs/nullableString" },
        "source_ref": { "$ref": "#/$defs/nullableString" },
        "pull_request_number": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "merge_method": {
          "type": ["string", "null"],
          "enum": ["merge", "squash", "rebase", null]
        },
        "commit_sha": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/nullableString" },
        "artifact_digest": { "$ref": "#/$defs/nullableDigest" },
        "environment": { "$ref": "#/$defs/nullableString" },
        "automation_level": { "enum": ["routine", "expensive", "critical"] },
        "policy_version": { "const": "1.0.0" },
        "grant_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "selection_digest": { "$ref": "#/$defs/digest" },
        "request_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "request_digest",
        "confirmation_status",
        "confirmed_at"
      ],
      "properties": {
        "artifact_type": { "const": "confirmation" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "confirmation_status": { "const": "confirmed" },
        "confirmed_at": { "type": "string", "minLength": 1 }
      }
    },
    "platformEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "platform",
        "workflow",
        "run_id",
        "commit_sha",
        "request_digest",
        "confirmation_status",
        "approval_status",
        "required_checks",
        "protected_ref",
        "protected_environment",
        "artifact_digest",
        "source_ref",
        "platform_evidence_digest"
      ],
      "properties": {
        "artifact_type": { "const": "platform-evidence" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "platform": { "enum": ["github-actions", "git-remote"] },
        "workflow": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "minLength": 1 },
        "request_digest": { "$ref": "#/$defs/digest" },
        "confirmation_status": { "enum": ["not-required", "confirmed"] },
        "approval_status": { "enum": ["not-required", "approved"] },
        "required_checks": { "enum": ["not-applicable", "passed"] },
        "protected_ref": { "$ref": "#/$defs/nullableString" },
        "protected_environment": { "$ref": "#/$defs/nullableString" },
        "artifact_digest": { "$ref": "#/$defs/nullableDigest" },
        "source_ref": { "type": "string", "minLength": 1 },
        "platform_evidence_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "run_id",
        "task_id",
        "status",
        "validation_level",
        "duration",
        "summary",
        "primary_error",
        "artifacts",
        "full_log",
        "blocker_codes",
        "backend",
        "grant_digest",
        "manifest_digest",
        "diff_digest",
        "selection_digest",
        "request_digest",
        "commit_sha",
        "confirmation_status",
        "automation_level",
        "backend_calls",
        "formal_authority",
        "platform",
        "evidence_digest"
      ],
      "properties": {
        "artifact_type": { "const": "evidence" },
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "run_id": { "type": "string", "minLength": 1 },
        "task_id": { "$ref": "common.schema.json#/$defs/stableId" },
        "status": { "enum": ["passed", "failed", "blocked", "cancelled"] },
        "validation_level": {
          "$ref": "common.schema.json#/$defs/validationLevel"
        },
        "duration": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?s$" },
        "summary": { "type": "string", "minLength": 1 },
        "primary_error": { "$ref": "#/$defs/nullableString" },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "full_log": { "type": "string" },
        "blocker_codes": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/blockerCode" },
          "uniqueItems": true
        },
        "backend": { "enum": ["local", "github-actions", "git-remote"] },
        "grant_digest": { "$ref": "#/$defs/digest" },
        "manifest_digest": { "$ref": "#/$defs/digest" },
        "diff_digest": { "$ref": "#/$defs/digest" },
        "selection_digest": { "$ref": "#/$defs/digest" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "commit_sha": { "type": "string", "minLength": 1 },
        "confirmation_status": {
          "enum": [
            "not-required-by-explicit-policy",
            "not-required-by-branch-policy",
            "confirmed",
            "required",
            "stale-or-mismatched",
            "invalid-task-configuration"
          ]
        },
        "automation_level": {
          "enum": ["routine", "expensive", "critical", "confirmation-required"]
        },
        "backend_calls": { "type": "integer", "minimum": 0 },
        "formal_authority": { "type": "boolean" },
        "platform": {
          "oneOf": [
            { "$ref": "#/$defs/platformEvidence" },
            { "type": "null" }
          ]
        },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
