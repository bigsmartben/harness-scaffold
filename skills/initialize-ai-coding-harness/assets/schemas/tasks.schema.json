{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-harness.local/schemas/tasks.schema.json",
  "title": "CI/CD task catalog",
  "x-harness-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["tasks"],
  "properties": {
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "automation_level", "auto_allowed", "backend", "working_directory", "supports_scope", "timeout", "outputs"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/stableId" },
          "category": { "enum": ["lint", "validation", "test", "build", "ci", "package", "push", "pull-request", "merge", "publish", "release", "deploy"] },
          "automation_level": { "enum": ["routine", "expensive", "critical"] },
          "auto_allowed": { "type": "boolean" },
          "source": { "type": "string", "minLength": 1 },
          "command_source": { "type": "string", "minLength": 1 },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "backend": { "enum": ["local", "github-actions", "git-remote"] },
          "working_directory": { "type": "string", "minLength": 1 },
          "supports_scope": { "$ref": "common.schema.json#/$defs/validationLevel" },
          "timeout": { "type": "string", "pattern": "^[1-9][0-9]*(ms|s|m|h)$" },
          "outputs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["report"],
            "properties": {
              "report": { "type": "string", "minLength": 1 },
              "artifacts": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "allOf": [
          {
            "oneOf": [
              {
                "required": ["source"],
                "not": { "required": ["command_source"] }
              },
              {
                "required": ["command_source"],
                "not": { "required": ["source"] }
              }
            ]
          },
          {
            "if": {
              "properties": { "backend": { "const": "local" } },
              "required": ["backend"]
            },
            "then": { "required": ["command"] }
          },
          {
            "if": {
              "properties": { "backend": { "const": "git-remote" } },
              "required": ["backend"]
            },
            "then": {
              "properties": {
                "category": { "const": "push" },
                "automation_level": { "const": "critical" },
                "auto_allowed": { "const": false }
              }
            }
          },
          {
            "if": {
              "properties": {
                "automation_level": { "enum": ["expensive", "critical"] }
              },
              "required": ["automation_level"]
            },
            "then": {
              "properties": {
                "auto_allowed": { "const": false }
              }
            }
          },
          {
            "if": {
              "properties": {
                "category": { "enum": ["push", "pull-request", "merge", "publish", "release", "deploy"] }
              },
              "required": ["category"]
            },
            "then": {
              "properties": {
                "automation_level": { "const": "critical" },
                "auto_allowed": { "const": false }
              }
            }
          }
        ]
      }
    }
  }
}
