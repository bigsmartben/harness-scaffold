{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-harness.local/schemas/pipeline.schema.json",
  "title": "Merge or publish pipeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "requires_independent_confirmation", "stages"],
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/stableId" },
    "kind": { "enum": ["merge", "publish"] },
    "requires_independent_confirmation": { "type": "boolean" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tasks"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/stableId" },
          "tasks": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/stableId" },
            "uniqueItems": true
          },
          "requires_evidence": { "type": "boolean" }
        }
      }
    }
  },
  "allOf": [
    {
      "properties": {
        "requires_independent_confirmation": { "const": true }
      }
    }
  ]
}
