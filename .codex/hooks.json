{
  "description": "Harness lifecycle enforcement for trusted projects.",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "sdd-harness hook",
            "commandWindows": "sdd-harness hook",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "sdd-harness hook",
            "commandWindows": "sdd-harness hook",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "sdd-harness hook",
            "commandWindows": "sdd-harness hook",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "sdd-harness hook",
            "commandWindows": "sdd-harness hook",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "sdd-harness hook",
            "commandWindows": "sdd-harness hook",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
