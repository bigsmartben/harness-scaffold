{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-coding-harness.local/schemas/governance.schema.json",
  "title": "Harness governance contracts",
  "x-harness-schema-version": "1.0.0",
  "oneOf": [
    { "$ref": "#/$defs/repositorySnapshot" },
    { "$ref": "#/$defs/sourceFacts" },
    { "$ref": "#/$defs/actionGraph" },
    { "$ref": "#/$defs/governanceRules" },
    { "$ref": "#/$defs/projectionLock" },
    { "$ref": "#/$defs/workGrant" },
    { "$ref": "#/$defs/actionRequest" },
    { "$ref": "#/$defs/confirmationPackage" },
    { "$ref": "#/$defs/gateDecision" },
    { "$ref": "#/$defs/actionEvidence" },
    { "$ref": "#/$defs/agentInput" },
    { "$ref": "#/$defs/agentOutput" },
    { "$ref": "#/$defs/ruleCandidate" },
    { "$ref": "#/$defs/reconciliationResult" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^|/)\\.\\.(/|$)" }
    },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "base": {
      "type": "object",
      "required": ["artifact_type", "schema_version"],
      "properties": {
        "artifact_type": { "type": "string", "minLength": 1 },
        "schema_version": { "$ref": "#/$defs/version" }
      }
    },
    "repositorySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "schema_version", "files", "snapshot_digest"],
      "properties": {
        "artifact_type": { "const": "repository-snapshot" },
        "schema_version": { "$ref": "#/$defs/version" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "digest"],
            "properties": {
              "path": { "$ref": "#/$defs/path" },
              "digest": { "$ref": "#/$defs/digest" }
            }
          }
        },
        "snapshot_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "sourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "fact_type", "binding_state", "source_refs", "value"],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 },
        "fact_type": {
          "enum": ["manifest", "action-binding", "governance-source", "governance-gap"]
        },
        "binding_state": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/bindingState"
        },
        "source_refs": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "value": { "type": "object" }
      }
    },
    "sourceFacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "snapshot_digest",
        "facts",
        "facts_digest"
      ],
      "properties": {
        "artifact_type": { "const": "source-facts" },
        "schema_version": { "$ref": "#/$defs/version" },
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "facts": {
          "type": "array",
          "items": { "$ref": "#/$defs/sourceFact" }
        },
        "facts_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "cwd": { "$ref": "#/$defs/path" },
        "environment": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "adapter": { "type": "string", "minLength": 1 },
        "workflow": { "$ref": "#/$defs/path" },
        "job": { "type": "string", "minLength": 1 },
        "required_reports": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" },
          "uniqueItems": true
        },
        "expected_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" },
          "uniqueItems": true
        }
      },
      "oneOf": [
        { "required": ["argv", "cwd"] },
        { "required": ["adapter", "workflow", "job"] }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "semantics",
        "subdomains",
        "source_refs",
        "invocation",
        "binding_state",
        "mutates_repository"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "semantics": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/actionSemantics"
        },
        "subdomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/subdomain"
          }
        },
        "source_refs": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "invocation": { "$ref": "#/$defs/invocation" },
        "binding_state": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/bindingState"
        },
        "mutates_repository": { "type": "boolean" }
      }
    },
    "blocker": {
      "type": "object",
      "required": ["code", "source_refs"],
      "properties": {
        "code": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/blockerCode"
        },
        "action_id": { "type": ["string", "null"] },
        "source_refs": { "$ref": "#/$defs/stringList" }
      },
      "additionalProperties": false
    },
    "actionGraph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "snapshot_digest",
        "facts_digest",
        "actions",
        "blockers",
        "action_graph_digest"
      ],
      "properties": {
        "artifact_type": { "const": "action-graph" },
        "schema_version": { "$ref": "#/$defs/version" },
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "facts_digest": { "$ref": "#/$defs/digest" },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/action" }
        },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocker" }
        },
        "action_graph_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "governanceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "action_id",
        "audience",
        "subdomains",
        "responsibility",
        "projection_id",
        "source_refs",
        "directive",
        "scope",
        "inheritance",
        "invocation",
        "preconditions",
        "postconditions",
        "enforcement_level",
        "confirmation_policy",
        "evidence",
        "failure"
      ],
      "properties": {
        "rule_id": { "type": "string", "minLength": 1 },
        "action_id": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "audience": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/audience"
        },
        "subdomains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/subdomain"
          }
        },
        "responsibility": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/responsibility"
        },
        "projection_id": { "$ref": "#/$defs/digest" },
        "source_refs": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "directive": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "inheritance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "conflict"],
          "properties": {
            "mode": { "enum": ["inherit", "override"] },
            "conflict": { "const": "fail" }
          }
        },
        "invocation": {
          "oneOf": [
            { "$ref": "#/$defs/invocation" },
            { "type": "null" }
          ]
        },
        "preconditions": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "postconditions": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "enforcement_level": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/enforcementLevel"
        },
        "confirmation_policy": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/confirmationPolicy"
        },
        "evidence": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocker_codes"],
          "properties": {
            "blocker_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/blockerCode"
              }
            }
          }
        }
      }
    },
    "governanceRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "matrix",
        "rules",
        "rules_digest"
      ],
      "properties": {
        "artifact_type": { "const": "governance-rules" },
        "schema_version": { "$ref": "#/$defs/version" },
        "projection_id": { "$ref": "#/$defs/digest" },
        "matrix": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["audience", "subdomain"],
            "properties": {
              "audience": {
                "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/audience"
              },
              "subdomain": {
                "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/subdomain"
              }
            }
          }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/governanceRule" }
        },
        "rules_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "projectionLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "snapshot_digest",
        "facts_digest",
        "action_graph_digest",
        "governance_schema_version",
        "projection_compiler_version",
        "maintainer_declarations_digest",
        "rules_digest",
        "blockers",
        "ready",
        "projection_lock_digest"
      ],
      "properties": {
        "artifact_type": { "const": "projection-lock" },
        "schema_version": { "$ref": "#/$defs/version" },
        "projection_id": { "$ref": "#/$defs/digest" },
        "snapshot_digest": { "$ref": "#/$defs/digest" },
        "facts_digest": { "$ref": "#/$defs/digest" },
        "action_graph_digest": { "$ref": "#/$defs/digest" },
        "governance_schema_version": { "$ref": "#/$defs/version" },
        "projection_compiler_version": { "type": "string", "minLength": 1 },
        "maintainer_declarations_digest": { "$ref": "#/$defs/digest" },
        "rules_digest": { "$ref": "#/$defs/digest" },
        "blockers": {
          "type": "array",
          "items": { "$ref": "#/$defs/blocker" }
        },
        "ready": { "type": "boolean" },
        "projection_lock_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "workGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "objective",
        "scope",
        "audiences",
        "standing_policy",
        "grant_digest"
      ],
      "properties": {
        "artifact_type": { "const": "governance-work-grant" },
        "schema_version": { "$ref": "#/$defs/version" },
        "projection_id": { "$ref": "#/$defs/digest" },
        "objective": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "audiences": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/audience"
          }
        },
        "standing_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["routine", "scope_expansion", "critical_external_action"],
          "properties": {
            "routine": { "const": "none" },
            "scope_expansion": { "const": "once_per_change_set" },
            "critical_external_action": { "const": "once_per_delivery" }
          }
        },
        "grant_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "actionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "grant_digest",
        "action_id",
        "audience",
        "scope",
        "parameters",
        "request_digest"
      ],
      "properties": {
        "artifact_type": { "const": "action-request" },
        "schema_version": { "$ref": "#/$defs/version" },
        "projection_id": { "$ref": "#/$defs/digest" },
        "grant_digest": { "$ref": "#/$defs/digest" },
        "action_id": { "type": "string", "minLength": 1 },
        "audience": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/audience"
        },
        "scope": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "not": { "enum": ["command", "argv", "cwd", "environment", "env"] }
          }
        },
        "request_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "confirmationPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "kind",
        "request_digests",
        "scope",
        "decision",
        "confirmation_digest"
      ],
      "properties": {
        "artifact_type": { "const": "confirmation-package" },
        "schema_version": { "$ref": "#/$defs/version" },
        "projection_id": { "$ref": "#/$defs/digest" },
        "kind": { "enum": ["change-set", "delivery"] },
        "request_digests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "scope": { "$ref": "#/$defs/stringList", "minItems": 1 },
        "decision": { "enum": ["approved", "rejected"] },
        "confirmation_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "status", "blocker_codes"],
      "properties": {
        "gate_id": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7"] },
        "status": { "enum": ["passed", "blocked", "pending"] },
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/blockerCode"
          }
        }
      }
    },
    "gateDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "request_digest",
        "gates",
        "status",
        "confirmation_required",
        "blocker_codes",
        "blocker_packet_digest",
        "decision_digest"
      ],
      "properties": {
        "artifact_type": { "const": "gate-decision" },
        "schema_version": { "$ref": "#/$defs/version" },
        "projection_id": { "$ref": "#/$defs/digest" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "gates": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/gate" }
        },
        "status": { "enum": ["passed", "blocked", "pending"] },
        "confirmation_required": { "type": "boolean" },
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/blockerCode"
          }
        },
        "blocker_packet_digest": { "$ref": "#/$defs/digest" },
        "decision_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "agentInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "role",
        "projection_id",
        "audience",
        "subdomain",
        "payload",
        "input_digest"
      ],
      "properties": {
        "artifact_type": { "const": "agent-input" },
        "schema_version": { "$ref": "#/$defs/version" },
        "role": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/agentRole"
        },
        "projection_id": { "$ref": "#/$defs/digest" },
        "audience": {
          "oneOf": [
            {
              "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/audience"
            },
            { "type": "null" }
          ]
        },
        "subdomain": {
          "oneOf": [
            {
              "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/subdomain"
            },
            { "type": "null" }
          ]
        },
        "payload": { "type": "object" },
        "input_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "agentOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "role",
        "projection_id",
        "status",
        "result",
        "blocker_codes",
        "output_digest"
      ],
      "properties": {
        "artifact_type": { "const": "agent-output" },
        "schema_version": { "$ref": "#/$defs/version" },
        "role": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/agentRole"
        },
        "projection_id": { "$ref": "#/$defs/digest" },
        "status": { "enum": ["completed", "blocked"] },
        "result": { "type": "object" },
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/blockerCode"
          }
        },
        "output_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "ruleCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "audience",
        "subdomain",
        "rules",
        "blocker_codes",
        "candidate_digest"
      ],
      "properties": {
        "artifact_type": { "const": "rule-candidate" },
        "schema_version": { "$ref": "#/$defs/version" },
        "projection_id": { "$ref": "#/$defs/digest" },
        "audience": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/audience"
        },
        "subdomain": {
          "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/subdomain"
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/governanceRule" }
        },
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/blockerCode"
          }
        },
        "candidate_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "reconciliationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "candidate_digests",
        "rules",
        "conflicts",
        "blocker_codes",
        "result_digest"
      ],
      "properties": {
        "artifact_type": { "const": "reconciliation-result" },
        "schema_version": { "$ref": "#/$defs/version" },
        "projection_id": { "$ref": "#/$defs/digest" },
        "candidate_digests": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "rules": {
          "type": "array",
          "items": { "$ref": "#/$defs/governanceRule" }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_ids", "reason"],
            "additionalProperties": false,
            "properties": {
              "rule_ids": { "$ref": "#/$defs/stringList", "minItems": 2 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/blockerCode"
          }
        },
        "result_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "actionEvidence": {
      "type": "object",
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "request_digest",
        "status",
        "blocker_codes",
        "evidence_digest"
      ],
      "properties": {
        "artifact_type": { "const": "action-evidence" },
        "schema_version": { "$ref": "#/$defs/version" },
        "projection_id": { "$ref": "#/$defs/digest" },
        "request_digest": { "$ref": "#/$defs/digest" },
        "action_id": { "type": "string" },
        "invocation_digest": { "$ref": "#/$defs/digest" },
        "exit_code": { "type": "integer" },
        "stdout_digest": { "$ref": "#/$defs/digest" },
        "stderr_digest": { "$ref": "#/$defs/digest" },
        "postconditions": { "type": "object" },
        "gate_decision": { "$ref": "#/$defs/gateDecision" },
        "status": { "enum": ["passed", "blocked", "failed"] },
        "blocker_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://ai-coding-harness.local/schemas/common.schema.json#/$defs/blockerCode"
          }
        },
        "evidence_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
