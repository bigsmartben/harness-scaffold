{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/3.0/harness.schema.json",
  "title": "Harness 3.0 configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rule_instances"],
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "rule_instances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "specification",
        "implementation",
        "verification",
        "delivery"
      ],
      "properties": {
        "specification": {
          "type": "array",
          "items": {"$ref": "#/$defs/ruleInstance"}
        },
        "implementation": {
          "type": "array",
          "items": {"$ref": "#/$defs/ruleInstance"}
        },
        "verification": {
          "type": "array",
          "items": {"$ref": "#/$defs/ruleInstance"}
        },
        "delivery": {
          "type": "array",
          "items": {"$ref": "#/$defs/ruleInstance"}
        }
      }
    }
  },
  "$defs": {
    "ruleInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "directive", "scope"],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "directive": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?:[A-Za-z0-9._*?-]+/)*[A-Za-z0-9._*?-]+$"
          }
        }
      }
    }
  }
}
