{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/3.0/governance.schema.json",
  "title": "Harness 3.0 deterministic model lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type",
    "schema_version",
    "components",
    "model",
    "rules",
    "source_digest",
    "projection_digest"
  ],
  "properties": {
    "artifact_type": {"const": "harness-model-lock"},
    "schema_version": {"const": "3.0.1"},
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_version",
        "contract_version",
        "compiler_version"
      ],
      "properties": {
        "core_version": {"const": "3.0.1"},
        "contract_version": {"const": "3.0.1"},
        "compiler_version": {"const": "3.0.1"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audiences",
        "responsibilities",
        "domains",
        "cells"
      ],
      "properties": {
        "audiences": {
          "const": ["maintainer", "consumer"]
        },
        "responsibilities": {
          "const": ["generate", "enforce"]
        },
        "domains": {
          "const": [
            "specification",
            "implementation",
            "verification",
            "delivery"
          ]
        },
        "cells": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/cell"}
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/projectedRule"}
    },
    "source_digest": {"$ref": "#/$defs/digest"},
    "projection_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "audience",
        "responsibility",
        "domain",
        "directive"
      ],
      "properties": {
        "cell_id": {
          "type": "string",
          "pattern": "^(maintainer|consumer)\\.(generate|enforce)\\.(specification|implementation|verification|delivery)$"
        },
        "audience": {
          "enum": ["maintainer", "consumer"]
        },
        "responsibility": {
          "enum": ["generate", "enforce"]
        },
        "domain": {
          "enum": [
            "specification",
            "implementation",
            "verification",
            "delivery"
          ]
        },
        "directive": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "projectedRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "kind",
        "rule_id",
        "directive",
        "scope",
        "source_ref"
      ],
      "properties": {
        "domain": {
          "enum": [
            "specification",
            "implementation",
            "verification",
            "delivery"
          ]
        },
        "kind": {"const": "guidance"},
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "directive": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
