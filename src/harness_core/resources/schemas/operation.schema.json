{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/governance-operation.schema.json",
  "title": "Harness typed governance operation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "operation_id",
    "operation_type",
    "target_rule_id",
    "base_revision",
    "payload",
    "payload_digest"
  ],
  "properties": {
    "contract_version": {"const": "4.0.0"},
    "operation_id": {
      "type": "string",
      "pattern": "^op-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "operation_type": {
      "enum": ["add", "update", "disable", "enable", "delete"]
    },
    "target_rule_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "base_revision": {"type": "integer", "minimum": 0},
    "payload": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["domain", "directive", "scope", "sources"],
          "properties": {
            "domain": {
              "enum": [
                "specification",
                "implementation",
                "verification",
                "delivery"
              ]
            },
            "directive": {"type": "string", "minLength": 1},
            "scope": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["source_type", "reference", "digest"],
                "properties": {
                  "source_type": {
                    "enum": [
                      "repository_fact",
                      "governance_source",
                      "user_intent"
                    ]
                  },
                  "reference": {"type": "string", "minLength": 1},
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation_type": {"enum": ["add", "update"]}
        },
        "required": ["operation_type"]
      },
      "then": {
        "properties": {
          "payload": {"type": "object"}
        }
      },
      "else": {
        "properties": {
          "payload": {"type": "null"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation_type": {"const": "add"}
        },
        "required": ["operation_type"]
      },
      "then": {
        "properties": {
          "base_revision": {"const": 0}
        }
      }
    }
  ]
}
