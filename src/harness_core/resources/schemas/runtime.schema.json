{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/2.0/runtime.schema.json",
  "x-harness-schema-version": "2.0.0",
  "oneOf": [
    {"$ref": "#/$defs/taskDecision"},
    {"$ref": "#/$defs/impactAnalysis"},
    {"$ref": "#/$defs/commitPlan"},
    {"$ref": "#/$defs/pushPlan"},
    {"$ref": "#/$defs/issuePlan"},
    {"$ref": "#/$defs/projectPolicyPlan"},
    {"$ref": "#/$defs/controlledDeliveryPlan"}
  ],
  "$defs": {
    "digest": {
      "$ref": "https://sdd-harness.dev/schemas/2.0/common.schema.json#/$defs/digest"
    },
    "stringList": {
      "$ref": "https://sdd-harness.dev/schemas/2.0/common.schema.json#/$defs/stringList"
    },
    "taskDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "task_id",
        "projection_id",
        "workspace_digest",
        "exact_action",
        "target_digest",
        "status",
        "decision_digest"
      ],
      "properties": {
        "artifact_type": {"const": "task-decision"},
        "schema_version": {"const": "2.0.0"},
        "task_id": {"type": "string", "minLength": 1},
        "projection_id": {"$ref": "#/$defs/digest"},
        "workspace_digest": {"$ref": "#/$defs/digest"},
        "exact_action": {"type": "string", "minLength": 1},
        "target_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["active", "expired"]},
        "decision_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "impactAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "base_commit",
        "workspace_digest",
        "changed_paths",
        "domains",
        "validation_level",
        "reasons",
        "impact_digest"
      ],
      "properties": {
        "artifact_type": {"const": "impact-analysis"},
        "schema_version": {"const": "2.0.0"},
        "base_commit": {"type": "string", "minLength": 1},
        "workspace_digest": {"$ref": "#/$defs/digest"},
        "changed_paths": {"$ref": "#/$defs/stringList"},
        "domains": {
          "type": "array",
          "items": {
            "$ref": "https://sdd-harness.dev/schemas/2.0/common.schema.json#/$defs/domain"
          },
          "uniqueItems": true
        },
        "validation_level": {
          "$ref": "https://sdd-harness.dev/schemas/2.0/common.schema.json#/$defs/validationLevel"
        },
        "reasons": {"$ref": "#/$defs/stringList"},
        "impact_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "commitPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "base_commit",
        "workspace_digest",
        "workspace_impact_scope",
        "commit_scope",
        "message",
        "partial_paths",
        "blocker_codes",
        "plan_digest"
      ],
      "properties": {
        "artifact_type": {"const": "commit-plan"},
        "schema_version": {"const": "2.0.0"},
        "base_commit": {"type": "string", "minLength": 1},
        "workspace_digest": {"$ref": "#/$defs/digest"},
        "workspace_impact_scope": {"$ref": "#/$defs/stringList"},
        "commit_scope": {"$ref": "#/$defs/stringList"},
        "message": {"type": "string", "minLength": 1},
        "partial_paths": {"$ref": "#/$defs/stringList"},
        "blocker_codes": {
          "type": "array",
          "items": {
            "$ref": "https://sdd-harness.dev/schemas/2.0/common.schema.json#/$defs/blockerCode"
          },
          "uniqueItems": true
        },
        "plan_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "issuePlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "provider",
        "repository",
        "local_path",
        "title",
        "body",
        "labels",
        "assignee",
        "controlled",
        "target_digest",
        "plan_digest"
      ],
      "properties": {
        "artifact_type": {"const": "issue-plan"},
        "schema_version": {"const": "2.0.0"},
        "provider": {"enum": ["local", "github"]},
        "repository": {"type": ["string", "null"]},
        "local_path": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "body": {"type": "string", "minLength": 1},
        "labels": {"$ref": "#/$defs/stringList"},
        "assignee": {"type": ["string", "null"]},
        "controlled": {"type": "boolean"},
        "target_digest": {"$ref": "#/$defs/digest"},
        "plan_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "pushPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "workspace_digest",
        "remote",
        "remote_url_digest",
        "branch",
        "commit_sha",
        "blocker_codes",
        "plan_digest"
      ],
      "properties": {
        "artifact_type": {"const": "push-plan"},
        "schema_version": {"const": "2.0.0"},
        "workspace_digest": {"$ref": "#/$defs/digest"},
        "remote": {"type": "string", "minLength": 1},
        "remote_url_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "branch": {"type": "string", "minLength": 1},
        "commit_sha": {"type": "string", "minLength": 1},
        "blocker_codes": {
          "type": "array",
          "items": {
            "$ref": "https://sdd-harness.dev/schemas/2.0/common.schema.json#/$defs/blockerCode"
          },
          "uniqueItems": true
        },
        "plan_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "projectPolicyPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "workspace_digest",
        "previous_projection_id",
        "projection_id",
        "current_policy_digest",
        "changes",
        "initialization_plan",
        "write_scope",
        "blocker_codes",
        "plan_digest"
      ],
      "properties": {
        "artifact_type": {"const": "project-policy-plan"},
        "schema_version": {"const": "2.0.0"},
        "workspace_digest": {"$ref": "#/$defs/digest"},
        "previous_projection_id": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "projection_id": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "current_policy_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "changes": {"type": "object"},
        "initialization_plan": {"type": ["object", "null"]},
        "write_scope": {"$ref": "#/$defs/stringList"},
        "blocker_codes": {
          "type": "array",
          "items": {
            "$ref": "https://sdd-harness.dev/schemas/2.0/common.schema.json#/$defs/blockerCode"
          },
          "uniqueItems": true
        },
        "plan_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "controlledDeliveryPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "schema_version",
        "projection_id",
        "workspace_digest",
        "action_id",
        "semantics",
        "action_digest",
        "source_refs",
        "target",
        "target_digest",
        "platform_evidence",
        "blocker_codes",
        "plan_digest"
      ],
      "properties": {
        "artifact_type": {"const": "controlled-delivery-plan"},
        "schema_version": {"const": "2.0.0"},
        "projection_id": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "workspace_digest": {"$ref": "#/$defs/digest"},
        "action_id": {"type": "string", "minLength": 1},
        "semantics": {
          "enum": [
            "pull-request",
            "merge",
            "publish",
            "release",
            "deploy",
            ""
          ]
        },
        "action_digest": {
          "oneOf": [
            {"$ref": "#/$defs/digest"},
            {"type": "null"}
          ]
        },
        "source_refs": {"$ref": "#/$defs/stringList"},
        "target": {"type": "object"},
        "target_digest": {"$ref": "#/$defs/digest"},
        "platform_evidence": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
            "artifact_type",
            "schema_version",
            "action_id",
            "provider",
            "repository",
            "target_digest",
            "status",
            "checks",
            "evidence_digest"
              ],
              "properties": {
            "artifact_type": {"const": "platform-gate-evidence"},
            "schema_version": {"const": "2.0.0"},
            "action_id": {"type": "string", "minLength": 1},
            "provider": {"type": "string", "minLength": 1},
            "repository": {"type": "string", "minLength": 1},
            "target_digest": {"$ref": "#/$defs/digest"},
            "status": {"const": "passed"},
            "checks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "status", "source", "evidence_id"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "status": {"const": "passed"},
                  "source": {"type": "string", "minLength": 1},
                  "evidence_id": {"type": "string", "minLength": 1}
                }
              }
            },
                "evidence_digest": {"$ref": "#/$defs/digest"}
              }
            }
          ]
        },
        "blocker_codes": {
          "type": "array",
          "items": {
            "$ref": "https://sdd-harness.dev/schemas/2.0/common.schema.json#/$defs/blockerCode"
          },
          "uniqueItems": true
        },
        "plan_digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
